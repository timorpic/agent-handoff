{
  "schema_version": 1,
  "task_id": "engineering-governance",
  "goal": "在现有人工接力模板内落地行为治理与文件范围门禁",
  "allowed_paths": [
    "AGENTS.md",
    "README.md",
    ".github/PULL_REQUEST_TEMPLATE.md",
    ".github/workflows/template-ci.yml",
    ".ai/tasks/engineering-governance.json",
    "scripts/ai-check.mjs",
    "scripts/ai-check.test.mjs",
    "docs/AI-GOVERNANCE.md",
    "docs/DEVELOPMENT.md"
  ],
  "forbidden_paths": [
    "MEMORY.md",
    ".handoff/**",
    "scripts/init.mjs",
    "scripts/bootstrap.sh"
  ],
  "constraints": {
    "allow_new_dependencies": false,
    "allow_database_changes": false,
    "allow_api_breaking_changes": false,
    "allow_unrelated_refactor": false
  },
  "acceptance": [
    "保留统一入口与人工切换边界",
    "文件级越界在 CI 返回失败",
    "覆盖新增、删除、重命名、未跟踪文件与非法契约",
    "测试仅在 GitHub Actions 执行，未验证状态如实报告"
  ]
}
